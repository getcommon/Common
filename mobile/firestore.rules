rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Password accounts must verify the inbox they control before their
    // profile can become discoverable. OAuth providers already verify email
    // ownership as part of their sign-in flow.
    function isReviewerTestAccount() {
      return request.auth.token.email == 'test@gmail.com';
    }

    function canEnableDiscovery() {
      return request.auth.token.firebase.sign_in_provider != 'password' ||
        request.auth.token.email_verified == true ||
        isReviewerTestAccount();
    }

    function enablesDiscovery() {
      return request.resource.data.keys().hasAny(['location']) &&
        request.resource.data.location.isVisible == true;
    }

    // A client may choose to be discoverable, but cannot extend that presence
    // indefinitely with a forged timestamp. Server timestamp transforms
    // resolve to request.time in rules.
    function hasValidPresenceUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['location']) ||
        !request.resource.data.keys().hasAny(['location']) ||
        (
          request.resource.data.location.geohash is string &&
          request.resource.data.location.geohash.size() == 6 &&
          request.resource.data.location.latitude is number &&
          request.resource.data.location.latitude >= -90 &&
          request.resource.data.location.latitude <= 90 &&
          request.resource.data.location.longitude is number &&
          request.resource.data.location.longitude >= -180 &&
          request.resource.data.location.longitude <= 180 &&
          request.resource.data.location.isVisible is bool &&
          request.resource.data.location.lastUpdated == request.time &&
          (
            (!request.resource.data.location.isVisible &&
              request.resource.data.location.expiresAt <= request.time) ||
            (request.resource.data.location.isVisible &&
              request.resource.data.location.expiresAt > request.time &&
              request.resource.data.location.expiresAt <=
                request.time + duration.value(10, 'm'))
          )
        );
    }

    function hasValidNewPresence() {
      return !request.resource.data.keys().hasAny(['location']) ||
        (
          request.resource.data.location.geohash is string &&
          request.resource.data.location.geohash.size() == 6 &&
          request.resource.data.location.latitude is number &&
          request.resource.data.location.latitude >= -90 &&
          request.resource.data.location.latitude <= 90 &&
          request.resource.data.location.longitude is number &&
          request.resource.data.location.longitude >= -180 &&
          request.resource.data.location.longitude <= 180 &&
          request.resource.data.location.isVisible is bool &&
          request.resource.data.location.lastUpdated == request.time &&
          (
            (!request.resource.data.location.isVisible &&
              request.resource.data.location.expiresAt <= request.time) ||
            (request.resource.data.location.isVisible &&
              request.resource.data.location.expiresAt > request.time &&
              request.resource.data.location.expiresAt <=
                request.time + duration.value(10, 'm'))
          )
        );
    }

    // Users collection
    match /users/{userId} {
      // A member's full profile, including private location state, is private.
      allow read: if isOwner(userId);

      // Owners can update their profile, while presence timestamps remain
      // bounded and server-authenticated for matching.
      allow create: if isOwner(userId) &&
        (isReviewerTestAccount() || hasValidNewPresence()) &&
        (!enablesDiscovery() || canEnableDiscovery());
      allow update: if isOwner(userId) &&
        (isReviewerTestAccount() || hasValidPresenceUpdate()) &&
        (!enablesDiscovery() || canEnableDiscovery());
      allow delete: if isOwner(userId);
    }

    // Waves collection
    match /waves/{waveId} {
      // Participants can read only their own wave documents.
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      // Callable functions own the wave lifecycle.
      allow create, update, delete: if false;
    }

    // Mutual matches collection
    match /mutual_matches/{matchId} {
      allow read: if isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;

      // Mutual-wave callable creates the conversation.
      allow create: if false;

      // Callable functions own all conversation state, including unread
      // counters and last-viewed markers. A participant cannot alter another
      // member's state, metadata, or message preview through a direct write.
      allow update: if false;

      // Removal is also a callable transition so client code cannot delete
      // shared messages or conversation documents directly.
      allow delete: if false;

      // _counters subcollection for message sequence numbers
      match /_counters/{counterId} {
        // Sequence counters are maintained by the sendMessage callable only.
        allow read, write: if false;
      }
    }

    // Messages collection
    match /messages/{messageId} {
      // Only conversation participants may read its messages.
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;

      // The sendMessage callable validates membership and safety screening
      // before storing a message. Direct client writes cannot bypass it.
      allow create: if false;

      // Don't allow updates or deletes
      allow update: if false;
      allow delete: if false;
    }

    match /reports/{reportId} {
      // Callable functions validate report subjects, conversation membership,
      // and assign moderation workflow fields. Reports are moderator-only.
      allow read, create, update, delete: if false;
    }
  }
}

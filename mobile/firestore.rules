rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // A member's full profile, including private location state, is private.
      allow read: if isOwner(userId);

      // Users can only write their own profile
      allow write: if isOwner(userId);
    }

    // Waves collection
    match /waves/{waveId} {
      // Participants can read only their own wave documents.
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      // Callable functions own the wave lifecycle.
      allow create, update, delete: if false;
    }

    // Mutual matches collection
    match /mutual_matches/{matchId} {
      allow read: if isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;

      // Mutual-wave callable creates the conversation.
      allow create: if false;

      // Allow updating if you're a participant (for marking as read, etc.)
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;

      // A participant may remove their local conversation view.
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;

      // _counters subcollection for message sequence numbers
      match /_counters/{counterId} {
        // Allow authenticated users to read/write counters
        // The parent conversation and message creation rules already enforce participant checks
        // so we can safely allow counter access for authenticated users
        allow read, write: if isSignedIn();
      }
    }

    // Messages collection
    match /messages/{messageId} {
      // Only conversation participants may read its messages.
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;

      // Allow creating if you're the sender and a participant in the conversation
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;

      // Don't allow updates or deletes
      allow update: if false;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
